[Unit]
Description=LLM tunnel teela-body -> teela-brain:8081 (Qwen 3.8 27B Q5 backup)
After=network-online.target
Wants=network-online.target

[Service]
# Brain llama.cpp stays loopback-only. Body reaches it at 127.0.0.1:8081.
# Cloud Hermes stays the default; switch Body Bot to qwen38-27b-q5 if xAI is down.
ExecStart=/usr/bin/ssh -N -L 127.0.0.1:8081:127.0.0.1:8081 roni@10.0.0.10 -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
